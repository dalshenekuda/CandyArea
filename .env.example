# Required for Hydrogen session (any random string locally; use a strong secret in production).
SESSION_SECRET=replace-with-a-long-random-string

# Storefront API — optional for local mock.shop demo; required for a linked Shopify store.
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
PUBLIC_CHECKOUT_DOMAIN=

# Customer Account API — only needed for /account routes against a real store.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=
